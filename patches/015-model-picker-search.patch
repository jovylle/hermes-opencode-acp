+    def _model_picker_apply_filter(self, state) -> None:
+        """Recompute the filtered rows for the /model picker search box.
+
+        The picker's composer doubles as a live search field while the modal
+        is open: ``state["query"]`` holds the typed text, and this rebuilds
+        ``state["_filtered_providers"]`` / ``state["_filtered_models"]`` — the
+        shared row lists the display, arrow navigation, and Enter selection
+        all read — then clamps ``selected`` into the visible range so the
+        cursor can never land on a filtered-out row.  An empty query behaves
+        as identity (all rows), so opening the picker without typing is
+        unchanged.  Case-insensitive substring match on provider name/slug,
+        and on the model name for the model stage.
+        """
+        q = (state.get("query") or "").strip().lower()
+        providers = state.get("providers") or []
+        if q:
+            state["_filtered_providers"] = [
+                (i, p) for i, p in enumerate(providers)
+                if q in str(p.get("name", "")).lower()
+                or q in str(p.get("slug", "")).lower()
+            ]
+        else:
+            state["_filtered_providers"] = list(enumerate(providers))
+        models = state.get("model_list") or []
+        if q:
+            state["_filtered_models"] = [m for m in models if q in str(m).lower()]
+        else:
+            state["_filtered_models"] = list(models)
+        # Clamp selected inside the visible rows.  Provider stage appends
+        # Cancel after the filtered rows; model stage appends Back + Cancel.
+        if state.get("stage") == "provider":
+            max_sel = len(state["_filtered_providers"])
+        else:
+            max_sel = len(state["_filtered_models"]) + 1
+        state["selected"] = min(max_sel, state.get("selected", 0))
+
