+++ b/tests/hermes_cli/test_model_picker_search.py
@@ -0,0 +1,112 @@
+from types import SimpleNamespace
+
+from hermes_cli.model_switch import ModelSwitchResult
+
+
+def _bound(fn, instance):
+    return fn.__get__(instance, type(instance))
+
+
+def _make_state(**overrides):
+    state = {
+        "stage": "provider",
+        "providers": [
+            {"name": "DeepSeek", "slug": "deepseek", "models": ["deepseek-v3"]},
+            {"name": "Anthropic", "slug": "anthropic", "models": ["claude-4.7"]},
+            {"name": "DeepInfra", "slug": "deepinfra", "models": ["llama-4"]},
+        ],
+        "model_list": [],
+        "selected": 5,
+        "query": "deep",
+    }
+    state.update(overrides)
+    return state
+
+
+def test_model_picker_apply_filter_filters_providers_and_clamps():
+    import cli as cli_mod
+
+    self_ = object.__new__(cli_mod.HermesCLI)
+    apply_filter = _bound(cli_mod.HermesCLI._model_picker_apply_filter, self_)
+
+    state = _make_state()
+    apply_filter(state)
+
+    # Case-insensitive substring on name/slug keeps DeepSeek + DeepInfra.
+    assert [p["name"] for _, p in state["_filtered_providers"]] == [
+        "DeepSeek",
+        "DeepInfra",
+    ]
+    # Cursor clamps to the last visible row (Cancel row at index len(filtered)).
+    assert state["selected"] == 2
+
+
+def test_model_picker_apply_filter_identity_when_query_empty():
+    import cli as cli_mod
+
+    self_ = object.__new__(cli_mod.HermesCLI)
+    apply_filter = _bound(cli_mod.HermesCLI._model_picker_apply_filter, self_)
+
+    state = _make_state(query="")
+    apply_filter(state)
+    assert len(state["_filtered_providers"]) == 3
+    assert state["selected"] == 3  # clamped to Cancel row (index = len(visible))
+
+
+def test_model_picker_apply_filter_model_stage():
+    import cli as cli_mod
+
+    self_ = object.__new__(cli_mod.HermesCLI)
+    apply_filter = _bound(cli_mod.HermesCLI._model_picker_apply_filter, self_)
+
+    state = _make_state(
+        stage="model",
+        providers=[],
+        model_list=["anthropic/claude-4.7", "anthropic/claude-4.6", "openai/gpt-5.5"],
+        query="claude",
+    )
+    apply_filter(state)
+    assert state["_filtered_models"] == ["anthropic/claude-4.7", "anthropic/claude-4.6"]
+    # Model stage appends Back + Cancel; clamp keeps Cancel reachable.
+    assert state["selected"] == 3
+
+
+def test_model_picker_no_matches_clamps_to_cancel():
+    import cli as cli_mod
+
+    self_ = object.__new__(cli_mod.HermesCLI)
+    apply_filter = _bound(cli_mod.HermesCLI._model_picker_apply_filter, self_)
+
+    state = _make_state(query="zzz-no-such-provider")
+    apply_filter(state)
+    assert state["_filtered_providers"] == []
+    assert state["selected"] == 0  # only Cancel remains
+
+
+def test_model_picker_escape_clears_query_before_closing(monkeypatch):
+    import cli as cli_mod
+
+    captured = {}
+
+    class _FakeApp:
+        current_buffer = SimpleNamespace(reset=lambda: captured.setdefault("reset", True))
+        def invalidate(self):
+            captured["invalidated"] = True
+
+    self_ = SimpleNamespace(
+        _app=_FakeApp(),
+        _model_picker_state={**_make_state(), "_filtered_providers": []},
+    )
+    self_._model_picker_apply_filter = _bound(cli_mod.HermesCLI._model_picker_apply_filter, self_)
+    self_._close_model_picker = lambda: captured.setdefault("closed", True)
+
+    event = SimpleNamespace(app=_FakeApp())
+    # The escape handler lives in the TUI layout builder; simulate its logic
+    # by invoking the same state transitions directly via the bound handler
+    # path is not feasible headless, so verify the state it relies on.
+    state = self_._model_picker_state
+    assert state.get("query") == "deep"
+    # Clearing the query must restore the full list.
+    state["query"] = ""
+    self_._model_picker_apply_filter(state)
+    assert len(state["_filtered_providers"]) == 3
